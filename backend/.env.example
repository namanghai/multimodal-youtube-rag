# ── Ollama (free, local LLM) ───────────────────────────────────────────────────
# Make sure Ollama is running:  ollama serve
# Pull your model first:        ollama pull llama3
OLLAMA_BASE_URL=http://localhost:11434/v1
# phi3 = fast on CPU (~2GB). Switch to llama3 for higher quality (slower).
CHAT_MODEL=phi3

# ── Embeddings (free, downloaded from HuggingFace on first run) ───────────────
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ── Chunking ──────────────────────────────────────────────────────────────────
CHUNK_DURATION_SECONDS=45
CHUNK_OVERLAP_SECONDS=10

# ── Vision / OCR ──────────────────────────────────────────────────────────────
# Requires Tesseract OCR installed at system level + ffmpeg on PATH
FRAME_SAMPLE_INTERVAL_SECONDS=5
SCENE_CHANGE_THRESHOLD=30.0
MAX_FRAMES_PER_VIDEO=40

# ── Retrieval ─────────────────────────────────────────────────────────────────
TOP_K_TEXT=5
TOP_K_VISUAL=3