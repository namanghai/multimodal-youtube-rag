# Free Local Models
EMBEDDING_MODEL=all-MiniLM-L6-v2
CHAT_MODEL=llama3
OLLAMA_BASE_URL=http://localhost:11434/v1

# Ingestion Settings
CHUNK_DURATION_SECONDS=45
CHUNK_OVERLAP_SECONDS=10

# Vision Settings
FRAME_SAMPLE_INTERVAL_SECONDS=5
SCENE_CHANGE_THRESHOLD=30.0
MAX_FRAMES_PER_VIDEO=40
USE_VISION_MODEL_FOR_FRAMES=false

# Retrieval Settings
TOP_K_TEXT=5
TOP_K_VISUAL=3